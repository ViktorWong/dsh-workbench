{
  "name": "@dsh-workbench/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Electron desktop shell hosting the DeepSeek Harness web service",
  "repository": {
    "type": "git",
    "url": "github:ViktorWong/dsh-workbench"
  },
  "author": "ViktorWong <ViktorWong@users.noreply.github.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pack": "pnpm prepare-runtime && NODE_OPTIONS=--max-old-space-size=8192 electron-builder --dir"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "electron": "44.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.0"
  }
}
