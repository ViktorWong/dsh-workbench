{
  "name": "dsh-workbench",
  "private": true,
  "version": "0.1.1",
  "description": "Open-source desktop workbench for DeepSeek Harness",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @dsh-workbench/desktop dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "pack:plugins": "pnpm -r --filter './plugins/*' run pack"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
