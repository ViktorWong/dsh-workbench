{
  "name": "@dsh-workbench/panel-workbench",
  "version": "1.2.2",
  "description": "Session console with subagent model routing, activity timeline, usage trends",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --outDir lib --dts && node -e \"require('fs').copyFileSync('src/client.js','lib/client.js')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/smoke-plugin.mjs",
    "pack": "pnpm pack"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
